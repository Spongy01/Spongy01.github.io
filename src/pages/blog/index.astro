---
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getPublishedPosts, postUrl, formatDate } from '../../utils/posts';

const posts = await getPublishedPosts();
---
<Base
  title="Blog, Ali Asgar Padaria"
  description="Writing by Ali Asgar Padaria."
  root="/"
  brandHref="/"
  nav={[
    { label: 'Projects', href: '/index.html#projects' },
    { label: 'Blog', href: '/blog/' },
  ]}
>
  <link slot="head" rel="stylesheet" href="/blog.css">

  <main class="site-main" id="main">
    <header class="blog-intro">
      <h1 class="blog-intro__title">Blog</h1>
      <p class="blog-intro__lede">Notes on what I am building and learning. Also available as an <a href="/rss.xml">RSS feed</a>.</p>
    </header>

    {posts.length === 0 ? (
      <p class="post-list__empty">No posts yet.</p>
    ) : (
      <ol class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <time class="post-item__date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h2 class="post-item__title"><a href={postUrl(post)}>{post.data.title}</a></h2>
              <p class="post-item__desc">{post.data.description}</p>
              <Tags tags={post.data.tags} />
            </div>
          </li>
        ))}
      </ol>
    )}
  </main>
</Base>
